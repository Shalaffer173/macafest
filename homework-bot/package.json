{
  "name": "homework-bot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот с мини-приложением: домашние задания, расписание и оценки из «Єдиної Школи»",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "demo": "DEMO=1 node src/server.js",
    "tunnel": "node src/dev-tunnel.js",
    "autostart": "bash scripts/autostart.sh",
    "check": "node src/check.js",
    "users": "node --no-warnings --env-file-if-exists=.env src/users.js",
    "test": "node --test"
  }
}
