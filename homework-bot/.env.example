# Токен бота от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес этого сервера (его же указать в BotFather как Mini App)
PUBLIC_URL=https://example.com
# Ключ шифрования сессий: 32 байта в hex. Сгенерировать: openssl rand -hex 32
SECRET_KEY=
# Необязательно
PORT=8080
DB_PATH=./data/bot.sqlite
SYNC_MINUTES=10
# Час вечерней сводки по Киеву по умолчанию (14–22); каждый может поменять свой в приложении
DIGEST_HOUR=18
# DEMO=1 — вымышленные задания вместо «Єдиної Школи», без Telegram и без входа
